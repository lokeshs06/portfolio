PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/portfolio locally)
MONGODB_URI=

# Long random string, at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Admin login. Create the hash with: npm run hash-password
# Keep the single quotes, the hash contains $ signs.
ADMIN_EMAIL=lokesh.s0926@gmail.com
ADMIN_PASSWORD_HASH=''

# Frontend URL(s) allowed to call the API, comma-separated
CLIENT_ORIGIN=http://localhost:5173
